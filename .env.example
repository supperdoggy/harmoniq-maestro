MONGO_ROOT_USERNAME=maestro
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=music-services

BOT_TOKEN=replace-me
BOT_WHITELIST=123456789
WEBHOOK_URL=http://album-queue:8080/health

SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Optional user OAuth refresh token. Required for Development Mode playlist reads.
SPOTIFY_REFRESH_TOKEN=
OPENAI_API_KEY=replace-me

MUSIC_LIBRARY_PATH=./data/music
SPOTDL_CONFIG_PATH=./.spotdl
PLAYLISTS_OUTPUT_PATH=/music/playlists
MEDIA_OUTPUT_TEMPLATE=/music/downloads/{artists}-{title}.{output-ext}
# Deprecated fallback for MEDIA_OUTPUT_TEMPLATE:
# DESTINATION=/music/downloads/{artists}-{title}.{output-ext}

SLEEP_IN_MINUTES=1
WORKER_POLL_INTERVAL=1m
WORKER_ID=
WORKER_LEASE_DURATION=45m
WORKER_RETRY_DELAY=15m
WORKER_MAX_ATTEMPTS=3
ACQUISITION_BACKEND=spotdl
ACQUISITION_AUDIO_FORMAT=mp3
ACQUISITION_COMMAND_TIMEOUT=30m
ACQUISITION_STAGING_PATH=/music/.staging
YTDLP_SEARCH_LIMIT=10
YTDLP_MINIMUM_SCORE=0.72
SPOTDL_BINARY=/usr/local/bin/spotdl
SPOTDL_USE_CONFIG=true
YTDLP_BINARY=/usr/local/bin/yt-dlp
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_DURATION_TOLERANCE=15s

DYNAMIC_PLAYLISTS_INTERVAL_SECONDS=3600
DRY_RUN=false

LOKI_ENABLED=false
LOKI_URL=
